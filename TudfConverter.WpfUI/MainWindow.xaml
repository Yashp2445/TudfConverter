<Window x:Class="TudfConverter.WpfUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="TUDF Converter" 
        Width="1280" Height="800" 
        MinWidth="1100" MinHeight="660"
        Background="{StaticResource AppBackground}"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource AppWhite}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo Area -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Height="64" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource PrimaryBlue}" Margin="0,0,12,0">
                        <TextBlock Text="TC" Foreground="{StaticResource AppWhite}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="TUDF Converter" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation Area -->
                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <TextBlock Text="MENU" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="SemiBold" Padding="16,12,16,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <!-- Simulate letter spacing with margin if needed, but standard font rendering is ok -->
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Command="{Binding NavigateToProcessFileCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="0">
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                                        <Setter Property="Background" Value="{StaticResource PrimaryBlueLight}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Background="{TemplateBinding Background}">
                                                        <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource PrimaryBlue}"/>
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" Margin="0,0,12,0"/>
                            <TextBlock Text="Process File"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToValidationResultsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="1">
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                                        <Setter Property="Background" Value="{StaticResource PrimaryBlueLight}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Background="{TemplateBinding Background}">
                                                        <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource PrimaryBlue}"/>
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" Margin="0,0,12,0"/>
                            <TextBlock Text="Validation Results"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToHistoryCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedNavIndex}" Value="2">
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                                        <Setter Property="Background" Value="{StaticResource PrimaryBlueLight}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Background="{TemplateBinding Background}">
                                                        <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource PrimaryBlue}"/>
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🕒" Margin="0,0,12,0"/>
                            <TextBlock Text="History"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Bottom Version/Help -->
                <StackPanel Grid.Row="2" Margin="16,0,16,24">
                    <TextBlock Text="v1.0.0" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                    <TextBlock Text="Help &amp; Support" Foreground="{StaticResource TextMuted}" FontSize="11" Cursor="Hand">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <Border Grid.Row="0" Background="{StaticResource AppWhite}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <ContentControl Content="{Binding PageTitle}" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                        <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='dd MMM yyyy'}" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Center View Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="MainContent" Content="{Binding CurrentView}"/>
            </ScrollViewer>

            <!-- Bottom Status Bar -->
            <Border Grid.Row="2" Background="{StaticResource AppWhite}" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource PrimaryBlue}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource WarningAmber}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    </StackPanel>
                    
                    <TextBlock Text="v1.0.0" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
