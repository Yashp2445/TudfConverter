<Application x:Class="TudfConverter.WpfUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TudfConverter.WpfUI"
             xmlns:converters="clr-namespace:TudfConverter.WpfUI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <converters:NullToVisibilityConverter x:Key="NullToVis"/>
            <converters:OutcomeToColorConverter x:Key="OutcomeToColor"/>
            <converters:StatusToColorConverter x:Key="StatusToColor"/>
            <converters:ZeroToVisibilityConverter x:Key="ZeroToVis"/>
            <converters:InverseZeroToVisibilityConverter x:Key="InverseZeroToVis"/>
            <converters:ProgressWidthConverter x:Key="ProgressWidthConverter"/>
            <converters:InitialsConverter x:Key="InitialsConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
