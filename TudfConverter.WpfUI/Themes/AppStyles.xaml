<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Color Palette -->
    <Color x:Key="AppWhiteColor">#FFFFFF</Color>
    <Color x:Key="AppBackgroundColor">#F8F9FC</Color>
    <Color x:Key="SurfaceColorValue">#FFFFFF</Color>
    <Color x:Key="SurfaceElevatedColor">#F0F2F7</Color>
    <Color x:Key="BorderLightColor">#E2E6EF</Color>
    <Color x:Key="BorderMediumColor">#C8CEDC</Color>
    <Color x:Key="PrimaryBlueColor">#1A56DB</Color>
    <Color x:Key="PrimaryBlueHoverColor">#1444B8</Color>
    <Color x:Key="PrimaryBlueLightColor">#EBF0FF</Color>
    <Color x:Key="SuccessGreenColor">#057A55</Color>
    <Color x:Key="SuccessGreenLightColor">#DEF7EC</Color>
    <Color x:Key="ErrorRedColor">#C81E1E</Color>
    <Color x:Key="ErrorRedLightColor">#FDE8E8</Color>
    <Color x:Key="WarningAmberColor">#92400E</Color>
    <Color x:Key="WarningAmberLightColor">#FEF3C7</Color>
    <Color x:Key="InfoBlueColor">#1E429F</Color>
    <Color x:Key="InfoBlueLightColor">#E1EFFE</Color>
    <Color x:Key="TextPrimaryColor">#111827</Color>
    <Color x:Key="TextSecondaryColor">#6B7280</Color>
    <Color x:Key="TextMutedColor">#9CA3AF</Color>
    <Color x:Key="TextOnPrimaryColor">#FFFFFF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AppWhite" Color="{StaticResource AppWhiteColor}"/>
    <SolidColorBrush x:Key="AppBackground" Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceColor" Color="{StaticResource SurfaceColorValue}"/>
    <SolidColorBrush x:Key="SurfaceElevated" Color="{StaticResource SurfaceElevatedColor}"/>
    <SolidColorBrush x:Key="BorderLight" Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="BorderMedium" Color="{StaticResource BorderMediumColor}"/>
    <SolidColorBrush x:Key="PrimaryBlue" Color="{StaticResource PrimaryBlueColor}"/>
    <SolidColorBrush x:Key="PrimaryBlueHover" Color="{StaticResource PrimaryBlueHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryBlueLight" Color="{StaticResource PrimaryBlueLightColor}"/>
    <SolidColorBrush x:Key="SuccessGreen" Color="{StaticResource SuccessGreenColor}"/>
    <SolidColorBrush x:Key="SuccessGreenLight" Color="{StaticResource SuccessGreenLightColor}"/>
    <SolidColorBrush x:Key="ErrorRed" Color="{StaticResource ErrorRedColor}"/>
    <SolidColorBrush x:Key="ErrorRedLight" Color="{StaticResource ErrorRedLightColor}"/>
    <SolidColorBrush x:Key="WarningAmber" Color="{StaticResource WarningAmberColor}"/>
    <SolidColorBrush x:Key="WarningAmberLight" Color="{StaticResource WarningAmberLightColor}"/>
    <SolidColorBrush x:Key="InfoBlue" Color="{StaticResource InfoBlueColor}"/>
    <SolidColorBrush x:Key="InfoBlueLight" Color="{StaticResource InfoBlueLightColor}"/>
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextOnPrimary" Color="{StaticResource TextOnPrimaryColor}"/>

    <!-- Typography -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="H3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="LabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    </Style>
    <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
    </Style>

    <!-- Buttons -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOnPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryBlueHover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource BorderMedium}"/>
                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.9"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AppWhite}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBlue}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryBlueLight}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AppBackground}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NavButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="LeftBorder" Width="3" HorizontalAlignment="Left" Background="{StaticResource PrimaryBlue}" Visibility="Hidden"/>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource AppBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
        <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
        <Setter Property="Background" Value="{StaticResource PrimaryBlueLight}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="{TemplateBinding Background}">
                        <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource PrimaryBlue}"/>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inputs -->
    <Style x:Key="InputStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource AppWhite}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BorderMedium}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource AppWhite}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Margin="{TemplateBinding Padding}" Grid.Column="0" Content="{TemplateBinding SelectionBoxItem}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <ToggleButton Grid.Column="1" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Background="Transparent" BorderThickness="0">
                                <Path Fill="{StaticResource TextSecondary}" Data="M 0 0 L 4 4 L 8 0 Z" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" x:Name="Popup">
                                <Border Background="{StaticResource AppWhite}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="4">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DataGrid -->
    <Style x:Key="DataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource AppWhite}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderLight}"/>
        <Setter Property="RowBackground" Value="{StaticResource AppWhite}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource AppBackground}"/>
        <Setter Property="RowHeight" Value="44"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource AppBackground}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="Height" Value="40"/>
                    <Setter Property="Padding" Value="12,0"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cards and Badges -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="8" Opacity="0.06" ShadowDepth="2" Color="Black"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StatCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="MinWidth" Value="140"/>
    </Style>

    <Style x:Key="BadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="8,3"/>
    </Style>
    <Style x:Key="BadgeSuccess" TargetType="Border" BasedOn="{StaticResource BadgeStyle}">
        <Setter Property="Background" Value="{StaticResource SuccessGreenLight}"/>
    </Style>
    <Style x:Key="BadgeError" TargetType="Border" BasedOn="{StaticResource BadgeStyle}">
        <Setter Property="Background" Value="{StaticResource ErrorRedLight}"/>
    </Style>
    <Style x:Key="BadgeWarning" TargetType="Border" BasedOn="{StaticResource BadgeStyle}">
        <Setter Property="Background" Value="{StaticResource WarningAmberLight}"/>
    </Style>
    <Style x:Key="BadgeInfo" TargetType="Border" BasedOn="{StaticResource BadgeStyle}">
        <Setter Property="Background" Value="{StaticResource InfoBlueLight}"/>
    </Style>
    <Style x:Key="BadgeNeutral" TargetType="Border" BasedOn="{StaticResource BadgeStyle}">
        <Setter Property="Background" Value="{StaticResource SurfaceElevated}"/>
    </Style>

</ResourceDictionary>
